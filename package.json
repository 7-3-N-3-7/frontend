{
  "name": "edu-journal",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/landing",
    "apps/dashboard"
  ],
  "scripts": {
    "dev": "node node_modules/next/dist/bin/next dev -H 0.0.0.0",
    "dev:landing": "npm --workspace=apps/landing run dev",
    "dev:dashboard": "npm --workspace=apps/dashboard run dev",
    "build": "next build",
    "build:all": "npm --workspaces run build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:bdd": "node --import tsx node_modules/@cucumber/cucumber/bin/cucumber.js --tags \"not @backend-only\"",
    "test:bdd:api": "node --import tsx node_modules/@cucumber/cucumber/bin/cucumber.js --tags \"@fullstack and not @ui-only and not @backend-only\"",
    "test:bdd:ui": "node --import tsx node_modules/@cucumber/cucumber/bin/cucumber.js --tags \"@ui and not @backend-only\""
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "next": "16.3.7",
    "next-auth": "^4.24.15",
    "next-intl": "^4.14.8",
    "react": "19.2.8",
    "react-bootstrap": "^2.10.10",
    "react-dom": "19.2.8",
    "react-error-boundary": "^6.1.6",
    "uncontrollable": "^9.0.0"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^12.9.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-istanbul": "^4.1.11",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "jsdom": "^29.1.1",
    "playwright": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
